# MongDee — environment variables reference (no secrets in this file).
#
# Nothing in this project auto-loads a .env file (no python-dotenv) — set
# these however your deployment target expects: `export VAR=...` in a
# shell, Docker Compose's `environment:` block (docker/docker-compose.yml
# already reads $CAM02_PASSWORD / $MONGDEE_API_KEY this way), or a Vercel
# project's Environment Variables screen. Config files reference them with
# "${VAR_NAME}" (see backend/config.py, camera_agent/config.py) so nothing
# secret ever needs to be committed to a JSON config.
#
# ---------------------------------------------------------------- AI Server
# Admin API key (backend/config.py: api.api_key, or use api.keys for
# per-role keys instead — see configs/mongdee.example.json).
MONGDEE_API_KEY=

# Per-camera RTSP/ONVIF credentials referenced from a camera config, e.g.
# {"password": "${CAM02_PASSWORD}"} in configs/mongdee.example.json.
CAM02_PASSWORD=
CAM03_PASSWORD=

# ------------------------------------------------------------- Camera Agent
# Must match one of the AI Server's keys above (needs at least "operator"
# role — see configs/camera_agent.example.json).
MONGDEE_AGENT_API_KEY=

# --------------------------------------------------------- Vercel Dashboard
# The AI Server's public URL, baked into the dashboard's config.js at
# build time as the *default* every viewer starts with (see
# scripts/build_web_dashboard.py, vercel.json). Viewers can still override
# it per-browser via the dashboard's own "server" settings dialog.
MONGDEE_AI_SERVER_URL=https://your-ai-server.example.com:8100
