__pycache__/
*.pyc
.venv/
.venv-fairface-gpu/  # isolated env for FairFace GPU/Pascal PyTorch-build testing — see README

# build_linux.sh / build_windows.bat output (PyInstaller) — see BUILD.md.
# The built launcher executable itself (MONGDEE-AI-Booth-OS / .exe) is meant
# to be copied to the project root and distributed, but that's a binary
# build artifact per machine, not source — never commit it.
.build_venv/
/build/
/dist/
*.spec
/MONGDEE-AI-Booth-OS
/MONGDEE-AI-Booth-OS.exe

# generated by install.sh/install.bat on each machine — not source
/run_launcher.sh
/run_launcher.bat

# regenerated automatically at runtime — not source
data/gallery/
data/booth_settings.json
data/*.db-journal
# WAL mode's companion files (core/database.py's init_db now enables it) —
# constantly rewritten while any process has the DB open, never meaningful
# to commit.
data/*.db-wal
data/*.db-shm
data/tmp/
.pytest_tmp/

# generated by scripts/build_web_dashboard.py — see apps/web/README.md
apps/web/dist/

# FairFace dataset (downloaded separately, see README) + trained checkpoints/
# logs (regenerated by train.py) — large binary/data artifacts, never source.
/dataset/
/models/fairface/
/models/fairface_smoketest/
/models/face_detector/*.onnx
/logs/
